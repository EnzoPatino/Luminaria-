# Copiar como .env únicamente en el servidor. Nunca subir este archivo ya completado.
POSTGRES_DB=luminaria
POSTGRES_USER=luminaria
POSTGRES_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_LARGO_Y_UNICO

# URL pública definitiva, sin barra final. Agregar una coma si se autorizan más orígenes.
CORS_ORIGIN=https://luminarias.neuquencapital.gob.ar
DOMAIN=luminarias.neuquencapital.gob.ar

# Generar con: openssl rand -hex 48
JWT_SECRET=REEMPLAZAR_POR_96_CARACTERES_ALEATORIOS

BOOTSTRAP_ADMIN_USERNAME=administrador
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_POR_14_O_MAS_CARACTERES_CON_MAYUSCULA_MINUSCULA_Y_NUMERO
BOOTSTRAP_ADMIN_NAME=Nombre del administrador
BOOTSTRAP_ADMIN_EMAIL=administrador@ejemplo.gob.ar

# Generar con: openssl rand -hex 32. Configurar también como header
# X-ChirpStack-Token en la integración HTTP de ChirpStack.
CHIRPSTACK_WEBHOOK_TOKEN=REEMPLAZAR_POR_64_CARACTERES_ALEATORIOS

# Tableros DEMO_* y sus dependencias se eliminan tras 5 minutos sin lecturas.
DEMO_DATA_TTL_MS=300000
DEMO_DATA_CLEANUP_INTERVAL_MS=60000

# Credencial del usuario backend_worker del broker Mosquitto.
MQTT_BACKEND_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_LARGO_Y_UNICO
MQTT_DASHBOARD_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_LARGO_Y_UNICO
MQTT_DEVICE_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_LARGO_Y_UNICO
