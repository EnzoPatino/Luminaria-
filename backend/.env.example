PORT=3000
NODE_ENV=development

# Seguridad: CORS (orígenes permitidos separados por coma, o vacío para orígenes locales en dev)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Seguridad: Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=luminaria
PGUSER=luminaria
PGPASSWORD=luminaria_dev

# Opcional: en lugar de las variables PG*, se puede usar DATABASE_URL
# DATABASE_URL=postgresql://luminaria:luminaria_dev@localhost:5432/luminaria

# Scheduler de mantenimiento: 24 h por defecto
MANTENIMIENTO_INTERVAL_MS=86400000

# Opcionales para el pool
PGPOOL_MAX=10
PGIDLE_TIMEOUT_MS=10000
PGCONNECT_TIMEOUT_MS=5000
