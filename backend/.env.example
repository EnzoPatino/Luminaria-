PORT=3000
NODE_ENV=development

# Seguridad: CORS (orígenes permitidos separados por coma, o vacío para orígenes locales en dev)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
TRUST_PROXY=loopback

# Seguridad: Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Seguridad: Integridad de ingesta por tablero
INGESTION_DEDUP_WINDOW_MS=5000
INGESTION_RATE_LIMIT_WINDOW_MS=60000
INGESTION_RATE_LIMIT_MAX_PER_TABLERO=120

# MQTT subscriber TCP 1883 -> PostgreSQL
MQTT_SUBSCRIBER_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=luminaria-backend-worker
MQTT_USERNAME=backend_worker
MQTT_PASSWORD=cambiar_en_produccion
MQTT_TOPICS=neuquen/iluminacion/#
MQTT_QOS=0
MQTT_KEEPALIVE_SECONDS=60
MQTT_RECONNECT_MS=5000
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_USE_TLS=false

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=luminaria
PGUSER=luminaria
PGPASSWORD=luminaria_dev

# Opcional: en lugar de las variables PG*, se puede usar DATABASE_URL
# DATABASE_URL=postgresql://luminaria:luminaria_dev@localhost:5432/luminaria

# Scheduler de mantenimiento: 24 h por defecto
MANTENIMIENTO_INTERVAL_MS=86400000

# Opcionales para el pool
PGPOOL_MAX=10
PGIDLE_TIMEOUT_MS=10000
PGCONNECT_TIMEOUT_MS=5000

# Supabase (autenticación con @supabase/server)
SUPABASE_URL=https://rhnglkhvqfmapwdbcktm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_o3mrqL8225YgCj31CdfFzA_XMrLPMk7
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://rhnglkhvqfmapwdbcktm.supabase.co/auth/v1/.well-known/jwks.json
